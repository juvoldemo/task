# Local: http://localhost:3000. Production: your HTTPS domain, without trailing slash.
APP_URL=http://localhost:3000
# Relative to project directory, or an absolute path on your persistent disk.
DATABASE_PATH=./data/teamflow.sqlite
NEXT_TELEMETRY_DISABLED=1
# Supabase Connect > Transaction pooler. Server-only; never NEXT_PUBLIC_.
# URL-encode special characters in the database password.
# SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full
